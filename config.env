# lan-gateway configuration
# After editing this file on an installed system run:  sudo lan-gateway reload
#
# Only devices on the LAN side (behind the access point) are restricted.
# The laptop itself keeps full, unfiltered internet access over Wi-Fi.

# ---- Interfaces (leave blank to auto-detect; check names with: ip -br link) ----
WAN_IF=""            # Wi-Fi interface that has internet, e.g. wlp2s0
LAN_IF=""            # Ethernet interface cabled to the access point, e.g. enp3s0

# ---- LAN addressing (must not overlap the Wi-Fi network's subnet) ----
# Sized for ~200 devices: 192.168.50.0/23 gives 497 DHCP addresses. Phones use a
# random MAC per network, so reconnects can take a fresh address; short leases
# return unused addresses to the pool quickly.
LAN_ADDR="192.168.50.1"
LAN_PREFIX="23"
DHCP_START="192.168.50.10"
DHCP_END="192.168.51.250"
DHCP_LEASE="2h"

# ---- Upstream DNS the laptop uses to resolve the allowed domains ----
UPSTREAM_DNS="1.1.1.1 8.8.8.8"

# ---- Allowed domains (one per line; every subdomain is included; no comments inside the quotes) ----
# fonts.googleapis.com + fonts.gstatic.com: Google Fonts used by accessibilitywheel.netlify.app
# wixstatic.com + parastorage.com: images, scripts and styles for tech4goodcommunity.com (a Wix site)
ALLOWED_DOMAINS="
idlistack.com
rforum.t4gc.in

connectivity-check.ubuntu.com
connectivitycheck.gstatic.com
captive.apple.com
www.msftconnecttest.com
dns.msftncsi.com

netlify.app
netlify.com

accessibilitywheel.netlify.app
fonts.googleapis.com
fonts.gstatic.com

tech4goodcommunity.com
wixstatic.com
parastorage.com
"

# ---- IP addresses that are always allowed, even without a DNS lookup ----
# The connectivity-check endpoints you supplied. They are also allowed by
# domain above, so if these IPs change the domain rule still works.
ALLOWED_IPS="
91.189.91.61
142.251.150.120
17.253.18.201
23.212.0.48
"

# ---- Ports LAN clients may use toward allowed destinations ----
ALLOWED_TCP_PORTS="80 443"
ALLOWED_UDP_PORTS="443"          # 443/udp = HTTP/3 (QUIC)

# ---- Application running locally on this laptop (gamesworkshop Summit) ----
LOCAL_APP_NAME="app.lan"         # LAN clients open http://app.lan  (audience: http://app.lan/audience)
LOCAL_APP_PORTS="8688"           # port(s) the app listens on (space separated)
LOCAL_APP_HTTP_REDIRECT="8688"   # send http://app.lan (port 80) to this port; blank to disable

# Run the app as a service that starts at boot. Leave LOCAL_APP_REPO blank to
# run the app yourself instead.
LOCAL_APP_REPO="https://github.com/ciaokitty/gamesworkshop"
LOCAL_APP_BRANCH="pixel"
LOCAL_APP_DIR=""                 # blank = ~/gamesworkshop of the user who runs sudo
LOCAL_APP_COMMAND="python3 scripts/run_summit.py --port 8688"
# macOS: run_summit.py reads /proc (Linux only), so the Mac runs the server directly
LOCAL_APP_COMMAND_MAC="python3 -B paperweights/room/server.py --port 8688 --bots 5"

# ---- Logging ----
LOG_DNS_QUERIES="yes"            # log every LAN DNS query (journalctl -u dnsmasq)
